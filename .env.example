# Copy this file to .env (next to MateSusu.exe, or the project root in the Editor). .env is ignored by git.
# Everything here can also be set in the app: right-click Susu > AI. What is set there wins over this file.

# Chat: Google Gemini. Free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY = ""
# gemini-3.8-flash (smartest), gemini-3.6-flash, gemini-3.5-flash-lite (fastest), gemini-3.1-flash-lite
GEMINI_CHAT_MODEL = "gemini-3.8-flash"
# Language Susu replies in: auto (English or Japanese, following you), en, ja
SUSU_REPLY_LANGUAGE = auto

# Voice for chat replies: elevenlabs (default, Susu's own voice) or gemini (free with the Gemini key)
SUSU_TTS_PROVIDER = "elevenlabs"
SUSU_SPEAK_REPLIES = true

# ElevenLabs: Susu's voice (also used for the pre-recorded voice lines and microphone transcription)
ELEVENLABS_API_KEY = ""
# Susu voice = Yui (ElevenLabs voice library); keep comments on their own line
ELEVENLABS_VOICE_ID = "fUjY9K2nAIwlALOwSiwc"
ELEVENLABS_MODEL = "eleven_v4"
# Model for live chat replies: eleven_v4 (best) or eleven_v4_turbo (faster)
ELEVENLABS_CHAT_MODEL = "eleven_v4"
ELEVENLABS_STABILITY = 0.45
ELEVENLABS_SIMILARITY = 0.8

# Gemini voice (when SUSU_TTS_PROVIDER = gemini): gemini-3.8-flash-tts or gemini-3.8-flash-lite-tts
GEMINI_TTS_MODEL = "gemini-3.8-flash-tts"
# Prebuilt voice: Leda (youthful), Zephyr (bright), Laomedeia (upbeat), Autonoe, Aoede, Achernar (soft), Vindemiatrix, Sulafat
GEMINI_TTS_VOICE = "Leda"
GEMINI_TTS_STYLE = "a cute, cheerful, affectionate young girl, soft and sweet"

# Voice pack the app plays: ja_elevenlabs (Yui, Eleven v4) or ja (older lines)
SUSU_VOICE_PACK = "ja_elevenlabs"

# Chat microphone (speech-to-text): elevenlabs (Scribe, needs ELEVENLABS_API_KEY) or gemini
SUSU_STT_PROVIDER = "elevenlabs"
ELEVENLABS_STT_MODEL = "scribe_v1"
GEMINI_STT_MODEL = "gemini-3.5-flash-lite"
# Language you speak (pt, en, ja...). Empty = detect automatically
SUSU_STT_LANGUAGE = ""
# Microphone name as Windows shows it. Empty = default microphone
SUSU_MIC_DEVICE = ""

# Idle motions between voice lines (pause in seconds) and the text over Susu's head for auto-talk lines
SUSU_IDLE_MOTIONS = true
SUSU_IDLE_MIN = 18
SUSU_IDLE_MAX = 40
SUSU_BALLOON = true
