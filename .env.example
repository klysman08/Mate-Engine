# Copy this file to .env and put your OpenRouter key below. .env is ignored by git.
API_KEY = "sk-or-v1-..."

# Chat (OpenRouter /chat/completions)
OPENROUTER_CHAT_ENABLED = true
OPENROUTER_CHAT_MODEL = "openai/gpt-4o-mini"

# Language: auto (mirror the user: English or Japanese), en, ja
OPENROUTER_LANGUAGE = auto

# Voice (OpenRouter /audio/speech)
# fish-audio/drama-3: voice = Fish Audio reference_id (empty = default voice); tone comes from INSTRUCTIONS
# (also works: hexgrad/kokoro-82m with voices af_heart / jf_alpha)
OPENROUTER_TTS_ENABLED = true
OPENROUTER_TTS_MODEL = "fish-audio/drama-3"
OPENROUTER_TTS_VOICE_EN = ""
OPENROUTER_TTS_VOICE_JA = ""
OPENROUTER_TTS_INSTRUCTIONS = "cute, cheerful, affectionate young girl, soft and sweet"
OPENROUTER_TTS_SPEED = 1.0
OPENROUTER_TTS_PITCH = 1.0
